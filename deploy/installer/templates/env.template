APP_NAME=SIDES
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL={{APP_URL}}

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos COMPARTIDA con SEPED v2 (la misma que usa seped_v2). El esquema lo
# manejan las migraciones de seped_v2: en este proyecto NO se corre `artisan migrate`.
DB_CONNECTION=mysql
DB_HOST={{DB_HOST}}
DB_PORT={{DB_PORT}}
DB_DATABASE={{DB_DATABASE}}
DB_USERNAME={{DB_USERNAME}}
DB_PASSWORD="{{DB_PASSWORD}}"

# Droguería de esta instalación (su codisb): el login sale con su logo.
SIDES_CODISB={{SIDES_CODISB}}

# Registros de auditoría que se conservan; al pasar de ese número se borran los más antiguos
# cada noche. 0 = no borrar nunca.
SIDES_AUDITORIA_MAXIMO=50000

# URL de SEPED v2 de la droguería: el FT pasa entre SEPED y SIDES con un botón (sso_pases).
SEPED_URL={{SEPED_URL}}

# Sesiones/cache en archivo para no mezclarse con las tablas sessions/cache de SEPED.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# WebSocket del monitor en vivo: los mismos valores del Reverb que ya corre seped_v2.
REVERB_APP_ID={{REVERB_APP_ID}}
REVERB_APP_KEY={{REVERB_APP_KEY}}
REVERB_APP_SECRET={{REVERB_APP_SECRET}}
REVERB_HOST="{{REVERB_HOST}}"
REVERB_PORT={{REVERB_PORT}}
REVERB_SCHEME={{REVERB_SCHEME}}
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# API del SIAD: tokens aceptados en /api/siad/{token}, separados por coma.
SIAD_API_TOKENS={{SIAD_API_TOKENS}}
# La misma API sin token en /api, con las direcciones del SIDES viejo: asi el SIAD que ya
# esta instalado sigue funcionando sin tocarle nada. Cuando el SIAD apunte a
# /api/siad/{token}, poner esto en false.
SIAD_API_ABIERTA={{SIAD_API_ABIERTA}}
